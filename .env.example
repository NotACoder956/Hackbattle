# ==========================================
# SOPIQ ENVIRONMENT CONFIGURATION
# ==========================================

# Control Plane Settings
CONTROL_PLANE_URL=http://localhost:8000
CONTROL_PLANE_PORT=8000
CONTROL_PLANE_DB_PATH=./apps/control-api/control_plane.db

# Private Agent Settings (Customer Perimeter)
AGENT_ID=agt_acme_hq_001
AGENT_TOKEN=sopq_agt_sample_secret_token
TENANT_ID=ten_0bf7f488ef41
AGENT_PORT=8001
STORAGE_PATH=./storage_data
AGENT_DB_PATH=./storage_data/private_agent.db

# Privacy & Data Egress Enforcement
# Allowed: PRIVATE_ONLY | SANITIZED | CUSTOMER_PROVIDER | REMOTE_PROVIDER
DATA_EGRESS_MODE=PRIVATE_ONLY

# AI Inference Providers (Local-First)
# Options: LOCAL | OLLAMA | CUSTOMER | REMOTE
LLM_MODE=LOCAL
LOCAL_LLM_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=llama3.2
EMBEDDING_MODEL=bge-small-en-v1.5

# Resource & Quota Limits
MAX_FILE_SIZE=52428800 # 50 MB in bytes
MAX_AUDIO_DURATION=14400 # 4 Hours in seconds
MAX_DOCUMENTS_PER_UPLOAD=10
MAX_CONCURRENT_PROCESSING_JOBS=4

# Web Console
WEB_PORT=3000
